HEARO_ENV=production
AWS_REGION=ap-south-1

HEARO_API_BASE_URL=http://127.0.0.1:8001
HEARO_INTERNAL_TOKEN=REPLACE_WITH_THE_SAME_API_INTERNAL_TOKEN

HEARO_MQTT_HOST=mqtt.example.com
HEARO_MQTT_PORT=8883
HEARO_MQTT_USERNAME=hearo-bridge
HEARO_MQTT_PASSWORD=REPLACE_WITH_BRIDGE_BROKER_PASSWORD
# Public-CA MQTT certificates should be verified with the OS trust store.
HEARO_MQTT_CA_PATH=/etc/ssl/certs/ca-certificates.crt

# Only during migration; leave empty afterward.
HEARO_LEGACY_HOUSEHOLD_ID=
