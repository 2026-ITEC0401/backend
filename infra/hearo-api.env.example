HEARO_ENV=production
AWS_REGION=ap-south-1
HEARO_STORE=dynamodb
HEARO_CORE_TABLE=hearo-core-v2-final
HEARO_ALERTS_TABLE=hearo-alerts-v2-final

# Generate independently: openssl rand -base64 48
HEARO_JWT_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
HEARO_INTERNAL_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_32_PLUS_CHARACTERS
HEARO_CORS_ORIGINS=https://frontend.example.com

# 행안부 주소기반산업지원서비스의 "검색 API" 승인키입니다.
# 팝업 API 승인키와 서로 바꾸어 사용할 수 없습니다.
HEARO_JUSO_CONFIRM_KEY=REPLACE_WITH_JUSO_SEARCH_API_KEY
# 행안부 주소기반산업지원서비스의 별도 "상세주소 API" 승인키입니다.
HEARO_JUSO_DETAIL_CONFIRM_KEY=REPLACE_WITH_JUSO_DETAIL_API_KEY
HEARO_JUSO_TIMEOUT_SECONDS=5

HEARO_MQTT_ENABLED=true
HEARO_MQTT_HOST=mqtt.example.com
HEARO_MQTT_PORT=8883
HEARO_MQTT_USERNAME=hearo-api
HEARO_MQTT_PASSWORD=REPLACE_WITH_BROKER_PASSWORD
# Public-CA MQTT certificates should be verified with the OS trust store.
HEARO_MQTT_CA_PATH=/etc/ssl/certs/ca-certificates.crt

# Used by the MQTT bridge on the same EC2 host.
HEARO_API_BASE_URL=http://127.0.0.1:8001
# Set only during the old hearo/log migration period.
HEARO_LEGACY_HOUSEHOLD_ID=
