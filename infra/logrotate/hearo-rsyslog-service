# Managed Hearo replacement template for the non-authentication portions of
# /etc/logrotate.d/rsyslog.
#
# DEPLOYMENT GATE: auth.log/authpriv and application security/audit events must
# first have a separate, access-controlled retention path of at least one
# calendar year. Back up and reconcile the host's existing rsyslog file; do not
# install duplicate stanzas for the paths below. This file intentionally does
# not include /var/log/auth.log or any authpriv destination.
/var/log/syslog
/var/log/mail.info
/var/log/mail.warn
/var/log/mail.err
/var/log/mail.log
/var/log/daemon.log
/var/log/kern.log
/var/log/user.log
/var/log/cron.log
/var/log/debug
/var/log/messages
{
    daily
    missingok
    rotate 90
    maxage 90
    compress
    delaycompress
    notifempty
    sharedscripts
    postrotate
        /usr/lib/rsyslog/rsyslog-rotate
    endscript
}
