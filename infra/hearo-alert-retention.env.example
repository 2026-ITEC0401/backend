# Required by hearo-alert-retention.service.
#
# Copy to /etc/hearo/hearo-alert-retention.env with root:root ownership and
# mode 0600. Every value is deliberately blank: an operator must obtain the
# live table names and ARNs from AWS and confirm the target before enabling the
# timer. Do not derive the confirmation values from the untrusted job input.
HEARO_RETENTION_REGION=
HEARO_RETENTION_ALERTS_TABLE=
HEARO_RETENTION_CORE_TABLE=
HEARO_RETENTION_CONFIRM_REGION=
HEARO_RETENTION_CONFIRM_ALERTS_TABLE=
HEARO_RETENTION_CONFIRM_CORE_TABLE=
HEARO_RETENTION_CONFIRM_ALERTS_TABLE_ARN=
HEARO_RETENTION_CONFIRM_CORE_TABLE_ARN=
