[Unit]
Description=Hearo FastAPI v2.5.0 production
After=network-online.target
Wants=network-online.target

# Install as hearo-api-v2-final.service only after staging verification.
[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/hearo-backend-v2-r7
EnvironmentFile=/etc/hearo/hearo-api-v2.env
ExecStart=/opt/hearo-backend-v2-r7/.venv/bin/python -B -E -m uvicorn dashboard_api_v2:app --host 127.0.0.1 --port 8001 --workers 1 --proxy-headers --root-path /v2
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
