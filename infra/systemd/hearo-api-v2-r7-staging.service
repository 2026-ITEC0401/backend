[Unit]
Description=Hearo FastAPI v2.5.0 isolated memory staging
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/hearo-backend-v2-r7
EnvironmentFile=/etc/hearo/hearo-api-v2-r7-staging.env
ExecStart=/opt/hearo-backend-v2-r7/.venv/bin/python -B -E -m uvicorn dashboard_api_v2:app --host 127.0.0.1 --port 8002 --workers 1 --proxy-headers --root-path /v2
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
